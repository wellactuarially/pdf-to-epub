{
  "page_ranges": {
    "skip": [],
    "content": [
      1,
      -1
    ]
  },
  "reading_order_strategy": "y_sort",
  "multi_column": {
    "enabled": false
  },
  "heading_detection": {
    "font_size_threshold": 1.05
  },
  "footnote_processing": {
    "enabled": true,
    "generate_backlinks": true
  },
  "table_extraction": {
    "enabled": true,
    "min_rows": 3,
    "min_columns": 2,
    "min_numeric_ratio": 0.35,
    "column_gap": 4.0
  },
  "chart_extraction": {
    "enabled": true,
    "min_area_ratio": 0.1,
    "max_text_density": 3.5,
    "dpi": 150
  }
}
